<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <select id="selectSetmealIdByDishId" resultType="java.lang.Long">
        select setmeal_id from setmeal_dish where dish_id in
        <foreach collection="dishID" item="dishId" separator="," open="(" close=")">
            #{dishId}
        </foreach>
    </select>

    <update id="updateStatus">
        update setmeal_dish
        <set>
        <if test="status !=null">status=#{status}</if>
        </set>
        where dish_id in
            <foreach collection="DishIds" item="dishId" separator="," open="(" close=")">
                #{dishId}
            </foreach>
    </update>

    <insert id="setmealAddDish">
        insert into setmeal_dish (copies,price,name,dish_id,setmeal_id)
        values
        <foreach collection="setmealDishes" item="setmealdish" separator=",">
            (#{setmealdish.copies},#{setmealdish.price},#{setmealdish.name},#{setmealdish.dishId},#{setmealdish.setmealId})
        </foreach>
    </insert>
</mapper>
